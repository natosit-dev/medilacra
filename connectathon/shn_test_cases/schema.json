{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medilacra.example/schemas/shn-reference-test-case.schema.json",
  "title": "MediLacra SHN reference test case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "label", "kind", "description", "operations", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^(TP|TN)-[0-9]{2}$"},
    "label": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["positive", "negative"]},
    "description": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "route": {"type": ["string", "null"]},
    "ig_line": {"type": ["string", "null"]},
    "member_id": {"type": ["string", "null"]},
    "service": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "system": {"type": "string"},
        "code": {"type": "string"},
        "display": {"type": "string"}
      }
    },
    "base_case": {"type": ["string", "null"]},
    "manual": {"type": "boolean"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {
            "enum": [
              "crd",
              "dtr",
              "pas_submit",
              "dtr_relaunch",
              "pas_inquire",
              "negative"
            ]
          },
          "source": {"type": ["string", "null"]},
          "route": {"type": ["string", "null"]},
          "service_code": {"type": ["string", "null"]},
          "mutation": {"type": ["string", "null"]},
          "expected": {"type": "object"}
        }
      }
    },
    "provenance": {"type": "object"}
  }
}
